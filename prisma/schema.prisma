generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id              String              @id @default(cuid())
  name            String?
  email           String              @unique
  password        String?
  emailVerified   DateTime?
  image           String?
  role            UserRole            @default(MEMBER)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  accounts        Account[]
  sessions        Session[]
  memberProfile   MemberProfile?
  applications    CourseApplication[]
  ventures        Venture[]
  shareOrders     ShareOrder[]
  taskCompletions TaskCompletion[]
  wallet          Wallet?
}

model MemberProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  phone         String
  referralCode  String?
  isApproved    Boolean  @default(false)
  policyConsent Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id                     String              @id @default(cuid())
  titleEn                String
  titleBn                String
  descriptionEn          String
  descriptionBn          String
  fee                    Float               @default(0)
  isScholarshipAvailable Boolean             @default(false)
  startDate              DateTime
  endDate                DateTime
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  applications           CourseApplication[]
}

model CourseApplication {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Venture {
  id            String   @id @default(cuid())
  proposerId    String
  titleEn       String
  titleBn       String
  descriptionEn String
  descriptionBn String
  leanCanvasUrl String?
  budget        Float
  status        String   @default("PROPOSED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  proposer      User     @relation(fields: [proposerId], references: [id])
}

model Brand {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameEn        String
  nameBn        String
  descriptionEn String
  descriptionBn String
  logoUrl       String?
  galleryUrls   String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Story {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleEn     String
  titleBn     String
  bodyEn      String
  bodyBn      String
  authorId    String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Document {
  id          String   @id @default(cuid())
  titleEn     String
  titleBn     String
  fileUrl     String
  category    String
  publishedAt DateTime
  createdAt   DateTime @default(now())
}

model KPI {
  id        String   @id @default(cuid())
  metric    String   @unique
  value     Float
  labelEn   String
  labelBn   String
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  quoteEn   String
  quoteBn   String
  authorEn  String
  authorBn  String
  roleEn    String
  roleBn    String
  createdAt DateTime @default(now())
}

model DonationIntent {
  id           String       @id @default(cuid())
  donorName    String
  donorEmail   String
  donorPhone   String
  amount       Float
  donationType DonationType
  isDomestic   Boolean      @default(true)
  receiptSent  Boolean      @default(false)
  createdAt    DateTime     @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String
  details   Json
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  EDITOR
  MEMBER
}

enum Locale {
  en
  bn
}

enum DonationType {
  UNRESTRICTED
  PROJECT_RESTRICTED
}

model Contact {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  subject     String
  message     String
  status      String   @default("unread") // unread, read, replied
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contacts")
}

// ─── Share Market Models ───────────────────────────────────────────────────

model Project {
  id              String        @id @default(cuid())
  titleEn         String
  titleBn         String
  descriptionEn   String
  descriptionBn   String
  imageUrl        String?
  totalCapital    Float
  totalShares     Int
  pricePerShare   Float
  availableShares Int
  status          ProjectStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  shareOrders ShareOrder[]
  dividends   Dividend[]
}

enum ProjectStatus {
  ACTIVE
  CLOSED
  PAUSED
}

model ShareOrder {
  id            String        @id @default(cuid())
  userId        String
  projectId     String
  quantity      Int
  pricePerShare Float
  totalAmount   Float
  paymentMethod PaymentMethod
  paymentRef    String?
  status        OrderStatus   @default(PENDING)
  adminNote     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

enum PaymentMethod {
  BKASH
  NAGAD
  ONLINE_GATEWAY
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Wallet & Dividend Models ─────────────────────────────────────────────

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Float    @default(0)
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String          @id @default(cuid())
  walletId    String
  type        TransactionType
  amount      Float
  description String
  createdAt   DateTime        @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}

enum TransactionType {
  DIVIDEND
  TASK_REWARD
  WITHDRAWAL
  SHARE_PURCHASE
}

model Dividend {
  id            String   @id @default(cuid())
  projectId     String
  month         Int
  year          Int
  percentage    Float
  totalAmount   Float
  isDistributed Boolean  @default(false)
  note          String?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, month, year])
}

// ─── Daily Task Models ────────────────────────────────────────────────────

model DailyTask {
  id          String   @id @default(cuid())
  titleEn     String
  titleBn     String
  platform    String
  url         String
  pointReward Int      @default(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  completions TaskCompletion[]
}

model TaskCompletion {
  id          String   @id @default(cuid())
  userId      String
  taskId      String
  completedAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task DailyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, completedAt])
  @@index([userId, completedAt])
  @@index([taskId])
}
